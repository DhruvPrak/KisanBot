{
  "info": {
    "name": "KisanBot Auth API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register User",
      "request": {
        "method": "POST",
        "url": "http://localhost:5000/api/auth/register",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Dhruv Prakash\",\"email\":\"dhruv@kisanbot.com\",\"password\":\"dhruv123\"}"
        }
      },
      "response": [
        {
          "name": "Register Success",
          "status": "Created",
          "code": 201,
          "body": "{\"success\":true,\"message\":\"User registered successfully\",\"token\":\"eyJhbGciOiJIUzI1NiJ9...\"}"
        }
      ]
    },
    {
      "name": "Login User",
      "request": {
        "method": "POST",
        "url": "http://localhost:5000/api/auth/login",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"dhruv@kisanbot.com\",\"password\":\"dhruv123\"}"
        }
      },
      "response": [
        {
          "name": "Login Success",
          "status": "OK",
          "code": 200,
          "body": "{\"success\":true,\"message\":\"Login successful\",\"token\":\"eyJhbGciOiJIUzI1NiJ9...\"}"
        }
      ]
    },
    {
      "name": "GET Protected Queries",
      "request": {
        "method": "GET",
        "url": "http://localhost:5000/api/queries",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}]
      },
      "response": [
        {
          "name": "Get Queries Success",
          "status": "OK",
          "code": 200,
          "body": "{\"success\":true,\"data\":[...]}"
        }
      ]
    },
    {
      "name": "POST Protected Query",
      "request": {
        "method": "POST",
        "url": "http://localhost:5000/api/queries",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{token}}"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"crop\":\"Rice\",\"problem\":\"Yellowing leaves\",\"advice\":\"Could be nitrogen deficiency\"}"
        }
      },
      "response": [
        {
          "name": "Create Query Success",
          "status": "Created",
          "code": 201,
          "body": "{\"success\":true,\"data\":{\"crop\":\"Rice\",\"problem\":\"Yellowing leaves\"}}"
        }
      ]
    },
    {
      "name": "Access Protected Route Without Token",
      "request": {
        "method": "POST",
        "url": "http://localhost:5000/api/queries",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\"crop\":\"Rice\",\"problem\":\"Test\"}"
        }
      },
      "response": [
        {
          "name": "Unauthorized",
          "status": "Unauthorized",
          "code": 401,
          "body": "{\"success\":false,\"message\":\"No token provided. Access denied.\"}"
        }
      ]
    },
    {
      "name": "Logout User",
      "request": {
        "method": "POST",
        "url": "http://localhost:5000/api/auth/logout",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}]
      },
      "response": [
        {
          "name": "Logout Success",
          "status": "OK",
          "code": 200,
          "body": "{\"success\":true,\"message\":\"Logged out successfully\"}"
        }
      ]
    }
  ]
}